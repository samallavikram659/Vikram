//@version=1
indicator("Order Flow Strategy", shorttitle="OF_Strategy", overlay=true)

// INPUTS
largeCandleMultiplier = input(1.5, title="Large Candle ATR Multiplier")
atrLength = input(14, title="ATR Length")
volumeAvgLen = input(10, title="Volume Avg Length")
rangeOverlapPct = input(70, title="Range Overlap %")
deltaThreshold = input(500, title="Strong Delta Threshold")
cvdLength = input(20, title="CVD Lookback Bars")

// CANDLE ANALYSIS
candleRange = high - low
atr = talib.sma(candleRange, atrLength)
isLargeCandle = candleRange > (atr * largeCandleMultiplier)
isBullishCandle = close > open
isBearishCandle = close < open

// DELTA TYPE (Type A = seller absorption, Type B = buyer absorption)
isTypeA = orderflow.mindelta < -deltaThreshold
isTypeB = orderflow.maxdelta > deltaThreshold

// CUMULATIVE DELTA (rolling sum as proxy for CVD)
cvd = talib.sum(orderflow.delta, cvdLength)
netLong = cvd > 0
netShort = cvd < 0

// VOLUME ANALYSIS
avgVolume = talib.sma(volume, volumeAvgLen)
lowVolume = volume < (avgVolume * 0.5)

// RANGE DETECTION (70% overlap between current and previous bar)
prevHigh = high[1]
prevLow = low[1]
prevRange = prevHigh - prevLow
overlapHigh = math.min(high, prevHigh)
overlapLow = math.max(low, prevLow)
overlap = math.max(0, overlapHigh - overlapLow)
overlapPct = prevRange > 0 ? (overlap / prevRange) * 100 : 0
isInRange = overlapPct >= rangeOverlapPct

// ABSORPTION ZONE: overlapping bars + low volume
isAbsZone = isInRange and lowVolume

// RANGE HIGH/LOW (use recent swing over last 5 bars)
rHigh = talib.highest(high, 5)
rLow = talib.lowest(low, 5)

// STRATEGY 1: INITIATIVE DRIVE
// Large candle in direction + absorption delta + net CVD confirms
bullInit = isLargeCandle and isBullishCandle and (isTypeA or isTypeB) and netLong
bearInit = isLargeCandle and isBearishCandle and (isTypeA or isTypeB) and netShort

// STRATEGY 2: ABSORPTION BREAKOUT
// Previous bar was absorption zone, current bar breaks out
absLong = isAbsZone[1] and close > rHigh[1] and netLong
absShort = isAbsZone[1] and close < rLow[1] and netShort

// STRATEGY 3: FAILED BREAKOUT
// Price spikes below/above range but closes back inside
failLong = low < rLow[1] and close > rLow[1] and netLong and isTypeB
failShort = high > rHigh[1] and close < rHigh[1] and netShort and isTypeA

// PLOT SIGNALS
plotshape(bullInit, title="Bull Init", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.normal, text="INIT")
plotshape(bearInit, title="Bear Init", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.normal, text="INIT")
plotshape(absLong, title="Abs Long", location=location.belowbar, color=color.lime, style=shape.arrowup, size=size.small, text="ABS")
plotshape(absShort, title="Abs Short", location=location.abovebar, color=color.maroon, style=shape.arrowdown, size=size.small, text="ABS")
plotshape(failLong, title="Fail Long", location=location.belowbar, color=color.aqua, style=shape.diamond, size=size.small, text="FAIL")
plotshape(failShort, title="Fail Short", location=location.abovebar, color=color.orange, style=shape.diamond, size=size.small, text="FAIL")

// PLOT RANGE
plot(rHigh, title="Range High", color=color.blue, linewidth=1)
plot(rLow, title="Range Low", color=color.blue, linewidth=1)
bgcolor(isAbsZone ? color.new(color.yellow, 90) : na, title="Absorption Zone")

// ALERTS
alertcondition(bullInit, title="Bull Initiative", message="Bullish Initiative Drive!")
alertcondition(bearInit, title="Bear Initiative", message="Bearish Initiative Drive!")
alertcondition(absLong, title="Abs Long", message="Absorption Breakout Long!")
alertcondition(absShort, title="Abs Short", message="Absorption Breakout Short!")
alertcondition(failLong, title="Fail Long", message="Failed Breakout Long!")
alertcondition(failShort, title="Fail Short", message="Failed Breakout Short!")
